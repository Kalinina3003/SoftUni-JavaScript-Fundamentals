// Task: Sum First and Last Array Elements
// Description: Receive an array of numbers and print the sum of its first and last element.

function sumFirstLastElements(input) {
    let first = input[0];
    let last = input[input.length - 1];
    console.log(first + last);
}
sumFirstLastElements([20, 30, 40]);
sumFirstLastElements([10, 17, 22, 33]);
sumFirstLastElements([11, 58, 69]);
